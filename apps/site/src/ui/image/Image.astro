---
import { Image as AstroImage } from "astro:assets";

import { image } from "./variants";

type Props = Partial<import("astro/types").ComponentProps<typeof AstroImage>> & {
  inferSize?: boolean;
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "auto" | "sync";
  loading?: "lazy" | "eager";
};

const {
  class: className,
  src,
  alt = "",
  inferSize = true,
  fetchpriority,
  loading = fetchpriority === "high" ? "eager" : undefined,
  decoding = "async",
  ...rest
} = Astro.props;
---

{
  src && (
    <AstroImage
      class={image({ class: className })}
      src={src}
      alt={alt}
      inferSize={inferSize}
      fetchpriority={fetchpriority}
      loading={loading}
      decoding={decoding}
      {...(rest as any)}
      data-slot="image"
    />
  )
}
