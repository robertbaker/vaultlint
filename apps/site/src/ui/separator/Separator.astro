---
import type { HTMLAttributes } from "astro/types";
import type { VariantProps } from "tailwind-variants";

import { separator } from "./variants";
import { withPalette, type PaletteProps } from "../../lib/palette";

type Props = (Omit<HTMLAttributes<"div">, "role" | "aria-orientation"> & VariantProps<typeof separator> & {
  "data-slot"?: string;
}) & PaletteProps;

const {
  orientation = "horizontal",
  "data-slot": dataSlot = "separator",
  class: className,
  ...rest
} = Astro.props;
---

<div
  {...withPalette(rest)}
  data-sw-separator
  role="separator"
  aria-orientation={orientation}
  data-orientation={orientation}
  class={separator({ orientation, class: className })}
  data-slot={dataSlot}
/>
