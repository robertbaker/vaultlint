---
import Default from "@astrojs/starlight/components/Footer.astro";
import { BRAND_LICENSE, BRAND_LINKS, BRAND_TAGLINE, TRADEMARK_NOTICE } from "@vaultlint/brand";
import LogoMark from "./LogoMark.astro";

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Default {...Astro.props} />

<div class="vl-site-footer">
  <div class="vl-site-footer-inner">
    <p class="vl-site-footer-brand"><LogoMark class="vl-fmark" /><span>vault<em>lint</em></span><small>{BRAND_TAGLINE.join(" ")}</small></p>
    <p class="vl-site-footer-links">
      <a href={`${base}security/privacy-policy/`}>Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href={`${base}security/local-first/`}>Local-First Architecture</a>
      <span aria-hidden="true">·</span>
      <a href={`${base}changelog/`}>Changelog</a>
      <span aria-hidden="true">·</span>
      <a href={BRAND_LINKS.repository}>GitHub ({BRAND_LICENSE})</a>
    </p>
    <p class="vl-site-footer-copy">
      &copy; {year} Robert Baker. <code>vaultlint</code> is free software released under the{" "}
      <a href={BRAND_LINKS.license}>GNU GPL v3.0</a>.
    </p>
    <p class="vl-site-footer-disclaimer">{TRADEMARK_NOTICE}</p>
  </div>
</div>

<style>
  .vl-site-footer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }

  .vl-site-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .vl-site-footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .vl-site-footer-links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .vl-site-footer-links a:hover,
  .vl-site-footer-links a:focus-visible {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
  }

  .vl-site-footer-copy {
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  .vl-site-footer-copy a {
    color: inherit;
    text-underline-offset: 2px;
  }

  .vl-site-footer-disclaimer {
    margin: 0;
    text-wrap: pretty;
  }

  .vl-site-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--vl-font-brand);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .vl-site-footer-brand em {
    color: var(--sl-color-accent);
    font-style: normal;
  }

  .vl-site-footer-brand small {
    margin-inline-start: 0.5rem;
    color: var(--sl-color-gray-3);
    font-family: var(--vl-font-sans);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    letter-spacing: 0;
  }

  .vl-site-footer-brand :global(.vl-fmark) {
    width: 1.4rem;
    height: 1.4rem;
  }
</style>
