---
/**
 * The vaultlint shield, rendered inline from the shared `@vaultlint/brand/logo.svg` so the site,
 * the Web UI, and the favicons all draw the same mark. Gradient ids are suffixed per instance so a
 * page can show the mark more than once (header + footer) without duplicate ids.
 */
import logo from "@vaultlint/brand/logo.svg?raw";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = `vl-mark-${Math.random().toString(36).slice(2, 8)}`;
const svg = logo
  .replace(/id="([\w-]+)"/g, `id="$1-${uid}"`)
  .replace(/url\(#([\w-]+)\)/g, `url(#$1-${uid})`)
  .replace(
    "<svg ",
    `<svg class="${className ?? ""}" aria-hidden="true" focusable="false" `,
  );
---

<Fragment set:html={svg} />
